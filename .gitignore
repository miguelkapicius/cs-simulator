# O repositório guarda o contrato com a Unity (contract/), os scripts que o geram e os testes.
# Entradas e dados intermediários ficam só na máquina e são regeráveis. Os padrões com / inicial valem só na raiz.

# Entradas da geração de dados
/demos/
/archives/
/reference/

# Dados intermediários extraídos das demos
/data/

# Pacotes para envio (repetem o JSON e o .md das pastas)
*.zip

# Ambiente Python e caches
.venv/
__pycache__/
*.pyc

# Sistema
.DS_Store

# Pacotes gerados por `make package`
dist/
.pytest_cache/

# Ledger e artefatos de execução de planos
/.superpowers/
